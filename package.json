{
  "name": "fiberblaze-wfm",
  "version": "1.0.0",
  "private": true,
  "description": "FiberBlaze Workforce Management (WFM) — Unified Dispatch, Cavite 3D Navigation, FTTH Field Execution, Offline Sync & Governance Platform",
  "scripts": {
    "predev": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.js')\"",
    "dev": "next dev --port 3000",
    "prebuild": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.js')\"",
    "build": "next build",
    "start": "next start --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jose": "^6.0.10",
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
